#[macro_export]
macro_rules! parse_drum {
    ($vec:ident) => {}; ($vec:ident , $($rest:tt)*) => { parse_drum!($vec $($rest)*); };
    ($vec:ident gap($ms:literal) $($rest:tt)*) => {
        let samples = (44100.0 * ($ms as f32 / 1000.0)) as usize; $vec.push(PatternElement::Wait(samples)); parse_drum!($vec $($rest)*);
    };
    ($vec:ident bass $($rest:tt)*) => { $vec.push(PatternElement::Play(Sound::DrumBass)); parse_drum!($vec $($rest)*); };
    ($vec:ident snare $($rest:tt)*) => { $vec.push(PatternElement::Play(Sound::DrumSnare)); parse_drum!($vec $($rest)*); };
    ($vec:ident $custom:ident $($rest:tt)*) => { $vec.push(PatternElement::Play(Sound::Sample(stringify!($custom).to_string()))); parse_drum!($vec $($rest)*); };
}


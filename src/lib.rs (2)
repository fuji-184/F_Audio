#[macro_export]
macro_rules! audio_impl {
    ($project:ident) => {}; ($project:ident , $($rest:tt)*) => { audio_impl!($project $($rest)*); };
    ($project:ident $sample_name:ident = read($path:literal) , $($rest:tt)*) => {
        $project.load_external_sample(stringify!($sample_name), $path); audio_impl!($project $($rest)*); 
    };
    ($project:ident drum { $($body:tt)* } $($rest:tt)*) => { parse_drum_loops!($project $($body)*); audio_impl!($project $($rest)*); };
    ($project:ident piano { $($body:tt)* } $($rest:tt)*) => { parse_piano_loops!($project $($body)*); audio_impl!($project $($rest)*); };
    ($project:ident bass { $($body:tt)* } $($rest:tt)*) => { parse_bass_loops!($project $($body)*); audio_impl!($project $($rest)*); };
    ($project:ident sax { $($body:tt)* } $($rest:tt)*) => { parse_sax_loops!($project $($body)*); audio_impl!($project $($rest)*); };
    // <--- [BARU] Blok integrasi seruling ke dalam engine utama
    ($project:ident flute { $($body:tt)* } $($rest:tt)*) => { parse_flute_loops!($project $($body)*); audio_impl!($project $($rest)*); };
    ($project:ident acouistic { $($body:tt)* } $($rest:tt)*) => { parse_acoustic_loops!($project $($body)*); audio_impl!($project $($rest)*); };
    ($project:ident start ( $($body:tt)* ) $($rest:tt)*) => { parse_start_pairs!($project $($body)*); audio_impl!($project $($rest)*); };
    ($project:ident stop ( $($body:tt)* ) $($rest:tt)*) => { parse_stop_pairs!($project $($body)*); audio_impl!($project $($rest)*); };
    ($project:ident gap($ms:literal) $($rest:tt)*) => { $project.add_command(Command::Gap($ms)); audio_impl!($project $($rest)*); };
}

#[macro_export]

    ($vec:ident $custom:ident $($rest:tt)*) => { $vec.push(PatternElement::Play(Sound::Sample(stringify!($custom).to_string()))); parse_flute!($vec $($rest)*); };
}

#[macro_export]
macro_rules! parse_acoustic {
    ($vec:ident) => {}; ($vec:ident , $($rest:tt)*) => { parse_acoustic!($vec $($rest)*); };
    ($vec:ident gap($ms:literal) $($rest:tt)*) => {
        let samples = (44100.0 * ($ms as f32 / 1000.0)) as usize; $vec.push(PatternElement::Wait(samples)); parse_acoustic!($vec $($rest)*);
    };
    ($vec:ident a $($rest:tt)*) => { $vec.push(PatternElement::Play(Sound::AcousticA)); parse_acoustic!($vec $($rest)*); };
    ($vec:ident d $($rest:tt)*) => { $vec.push(PatternElement::Play(Sound::AcousticD)); parse_acoustic!($vec $($rest)*); };
    ($vec:ident $custom:ident $($rest:tt)*) => { $vec.push(PatternElement::Play(Sound::Sample(stringify!($custom).to_string()))); parse_acoustic!($vec $($rest)*); };
}

